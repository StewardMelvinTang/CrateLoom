{
  "name": "CrateLoom neutral UI",
  "note": "Brand + UI chrome only. Waveform RGB, cue and section colours stay functional and are not part of this palette.",
  "tokens": {
    "surface.window": {
      "light": "#F4F4F4",
      "dark": "#181818",
      "use": "Window background, toolbars"
    },
    "surface.sidebar": {
      "light": "#EBEBEB",
      "dark": "#1F1F1F",
      "use": "Sidebar / source list"
    },
    "surface.content": {
      "light": "#FFFFFF",
      "dark": "#121212",
      "use": "Track tables, editors, waveform well"
    },
    "surface.elevated": {
      "light": "#FFFFFF",
      "dark": "#262626",
      "use": "Popovers, sheets, inspectors"
    },
    "text.primary": {
      "light": "#111111",
      "dark": "#F2F2F2",
      "use": "Titles, track names"
    },
    "text.secondary": {
      "light": "#5E5E5E",
      "dark": "#A6A6A6",
      "use": "Artist, BPM, key, metadata"
    },
    "text.tertiary": {
      "light": "#8A8A8A",
      "dark": "#717171",
      "use": "Placeholders, disabled (not for body text)"
    },
    "border.subtle": {
      "light": "#E2E2E2",
      "dark": "#2C2C2C",
      "use": "Row separators, panel dividers"
    },
    "border.strong": {
      "light": "#C4C4C4",
      "dark": "#424242",
      "use": "Inputs, secondary buttons"
    },
    "action.primary.bg": {
      "light": "#111111",
      "dark": "#F2F2F2",
      "use": "Export to rekordbox, Analyze"
    },
    "action.primary.text": {
      "light": "#FFFFFF",
      "dark": "#111111",
      "use": "Label on primary"
    },
    "action.primary.hover": {
      "light": "#2B2B2B",
      "dark": "#D9D9D9",
      "use": "Hover / pressed"
    },
    "selection.active.bg": {
      "light": "#111111",
      "dark": "#F2F2F2",
      "use": "Selected rows, list has focus"
    },
    "selection.active.text": {
      "light": "#FFFFFF",
      "dark": "#111111",
      "use": "Text on active selection"
    },
    "selection.inactive.bg": {
      "light": "#DCDCDC",
      "dark": "#333333",
      "use": "Selected rows, window not key"
    },
    "focus.ring": {
      "light": "#000000",
      "dark": "#FFFFFF",
      "use": "2 px ring"
    },
    "focus.ringGap": {
      "light": "#FFFFFF",
      "dark": "#121212",
      "use": "2 px gap between control and ring"
    }
  }
}